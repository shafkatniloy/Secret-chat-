PORT=3000
FRONTEND_URL=http://localhost:3001

# MongoDB Atlas Connection String
# Get from: https://www.mongodb.com/cloud/atlas (free tier)
# Format: mongodb+srv://username:password@cluster.mongodb.net/secret-chat
MONGODB_URI=mongodb://localhost:27017/secret-chat

# Cloudinary Image Storage
# Get from: https://cloudinary.com (free tier - 10GB)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# User Credentials (username:password pairs)
# Store your actual credentials in .env (never commit to git)
